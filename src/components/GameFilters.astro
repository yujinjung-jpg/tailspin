---
import type { Category, Publisher } from '../types/game';

/** Props for the category/publisher filter controls. */
interface Props {
    /** Categories offered as checkboxes. */
    categories: Category[];
    /** Publishers offered in the select. */
    publishers: Publisher[];
    /** Total number of games shown before filtering. */
    total: number;
}

const { categories, publishers, total } = Astro.props;
const focus = 'focus:ring-2 focus:ring-blue-500 focus:outline-none';
---

<form
    id="game-filters"
    class="mb-8 bg-slate-800/60 rounded-xl border border-slate-700/50 p-6"
    aria-label="Filter games"
    data-testid="game-filters"
    data-total={total}
>
    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
        <fieldset class="min-w-0">
            <legend class="text-sm font-medium text-slate-300 mb-2">Categories</legend>
            <div class="flex flex-wrap gap-x-5 gap-y-2">
                {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm text-slate-200 cursor-pointer">
                        <input
                            type="checkbox"
                            name="category"
                            value={category.id}
                            class={`h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 ${focus}`}
                            data-testid={`category-filter-${category.id}`}
                        />
                        {category.name}
                    </label>
                ))}
            </div>
        </fieldset>

        <div class="flex flex-col gap-2">
            <label for="publisher-filter" class="text-sm font-medium text-slate-300">Publisher</label>
            <select
                id="publisher-filter"
                name="publisher"
                class={`rounded-lg bg-slate-900 border border-slate-600 text-slate-100 text-sm px-3 py-2 ${focus}`}
                data-testid="publisher-filter"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>
    </div>

    <div class="mt-4 flex items-center justify-between gap-4">
        <p
            class="text-sm text-slate-400"
            role="status"
            aria-live="polite"
            data-testid="results-count"
        >
            Showing {total} of {total} games
        </p>
        <button
            type="reset"
            class={`rounded-lg px-3 py-1.5 text-sm text-slate-200 bg-slate-700 hover:bg-slate-600 transition-colors ${focus}`}
            data-testid="clear-filters"
        >
            Clear filters
        </button>
    </div>
</form>

<script>
    const form = document.querySelector<HTMLFormElement>('#game-filters');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const status = document.querySelector<HTMLElement>('[data-testid="results-count"]');
    const empty = document.querySelector<HTMLElement>('[data-testid="no-results"]');

    /**
     * Shows/hides game cards based on the form's selected filters, updates the
     * results count and empty state, and syncs the selection to the URL query.
     */
    function apply(): void {
        if (!form || !status) return;
        const categoryIds = new FormData(form).getAll('category').map(String);
        const publisherId = String(new FormData(form).get('publisher') ?? '');

        let visible = 0;
        for (const card of cards) {
            const matches =
                (categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '')) &&
                (publisherId === '' || card.dataset.publisherId === publisherId);
            card.style.display = matches ? '' : 'none';
            if (matches) visible++;
        }
        status.textContent = `Showing ${visible} of ${cards.length} games`;
        empty?.toggleAttribute('hidden', visible !== 0);

        const params = new URLSearchParams();
        categoryIds.forEach((id) => params.append('category', id));
        if (publisherId) params.set('publisher', publisherId);
        const query = params.toString();
        history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }

    if (form) {
        const params = new URLSearchParams(location.search);
        const selected = params.getAll('category');
        form.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((input) => {
            input.checked = selected.includes(input.value);
        });
        const publisher = form.querySelector<HTMLSelectElement>('select[name="publisher"]');
        if (publisher) publisher.value = params.get('publisher') ?? '';
        if (publisher && publisher.value !== (params.get('publisher') ?? '')) publisher.value = '';

        form.addEventListener('change', apply);
        form.addEventListener('submit', (event) => event.preventDefault());
        // reset restores defaults after the event, so re-apply on the next tick
        form.addEventListener('reset', () => setTimeout(apply));
        apply();
    }
</script>
